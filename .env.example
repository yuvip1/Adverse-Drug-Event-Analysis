# Example environment file for FAERS project
# Edit and copy to .env in the project root
# SQL Server connection string (Windows Auth by default)
SQLSERVER_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=faers;Trusted_Connection=yes;Trusted_Connection=Yes;

# For Docker (Linux container) use SQL authentication instead:
# SQLSERVER_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=faers;UID=sa;PWD=YourStrongPasswordHere;
