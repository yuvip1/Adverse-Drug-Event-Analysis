# Example environment file for FAERS project
# Edit and copy to .env in the project root
# SQL Server connection string (Windows Auth by default)
# Default instance (no \INSTANCENAME) -> Server=localhost
# Encrypt=No because the local dev instance uses a self-signed cert
SQLSERVER_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=faers;Trusted_Connection=yes;Encrypt=No

# For Docker (Linux container) use SQL authentication instead:
# SQLSERVER_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=faers;UID=sa;PWD=YourStrongPasswordHere;Encrypt=Yes;TrustServerCertificate=yes